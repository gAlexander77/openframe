# Logs
logs
*.log
npm-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.sw?

# Rust build output
src-tauri/target/
src-tauri/gen/schemas/

# Obsidian's per-machine workspace state — the vault's markdown is the shared
# artifact, its editor UI state is not
docs/.obsidian/

# Playwright MCP scratch output (page snapshots from harness runs)
.playwright-mcp/

# Generated test media (scripts/make-fixtures.mjs regenerates it with ffmpeg)
fixtures/media/

# Screenshots the drive scripts write beside themselves
scripts/drive/shots/

# Per-worktree scratch: playwright-core for drives, isolated app data,
# browser profiles and logs (docs/Driving the app.md)
scratch/

# UX audit captures: the raw PNGs run to megabytes per round and stay local;
# the few shots an audit cites are committed as JPEGs beside them
scripts/ui-review/shots/**/*.png
