// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`snapshots a minimal timeline's XML 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.10"><resources><format id="f1" frameDuration="1/25s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)"/><effect id="dissolve" name="Cross Dissolve" uid="FxPlug:4731E73A-8DAC-4113-9A30-AE85B1761265"/></resources><library><event name="OpenFrame"><project name="A &amp; &quot;B&quot;"><sequence format="f1" duration="1/25s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k"><spine><gap name="Gap" offset="0/25s" start="0/25s" duration="1/25s"><metadata><md key="com.openframe.track" value="{&quot;name&quot;:&quot;Main&quot;,&quot;main&quot;:true,&quot;kind&quot;:&quot;video&quot;,&quot;order&quot;:0}"/></metadata></gap></spine></sequence></project></event></library></fcpxml>
"
`;

exports[`snapshots a minimal timeline's XML 2`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.10"><resources><format id="f1" frameDuration="1/25s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)"/><effect id="dissolve" name="Cross Dissolve" uid="FxPlug:4731E73A-8DAC-4113-9A30-AE85B1761265"/><asset id="a1" name="Long shot.mp4" start="0s" duration="750/25s" hasVideo="1" hasAudio="1" format="f1" audioSources="1" audioChannels="2"><media-rep kind="original-media" src="file:///C:/Media/Long%20shot.mp4"/></asset><asset id="a2" name="Music.wav" start="0s" duration="750/25s" hasVideo="0" hasAudio="1" audioSources="1" audioChannels="2"><media-rep kind="original-media" src="https://media.test/Music.wav"/></asset><media id="c1" name="Nested"><sequence format="f1" duration="50/25s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k"><spine><gap name="Gap" offset="0/25s" start="0/25s" duration="10/25s"><metadata><md key="com.openframe.track" value="{&quot;name&quot;:&quot;Nested main&quot;,&quot;main&quot;:true,&quot;kind&quot;:&quot;video&quot;,&quot;order&quot;:0}"/></metadata></gap><asset-clip ref="a1" name="Long shot.mp4" offset="10/25s" start="75/25s" duration="40/25s"><marker start="77/25s" duration="1/25s" value="Inside"/><metadata><md key="com.openframe.track" value="{&quot;name&quot;:&quot;Nested main&quot;,&quot;main&quot;:true,&quot;kind&quot;:&quot;video&quot;,&quot;order&quot;:0}"/></metadata></asset-clip></spine></sequence></media></resources><library><event name="OpenFrame"><project name="Cuts &amp; layers"><sequence format="f1" duration="180/25s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k"><spine><asset-clip ref="a1" name="Long shot.mp4" offset="0/25s" start="50/25s" duration="45/25s"><asset-clip ref="a1" name="Long shot.mp4" lane="1" offset="75/25s" start="250/25s" duration="30/25s"><metadata><md key="com.openframe.track" value="{&quot;name&quot;:&quot;Overlay&quot;,&quot;main&quot;:false,&quot;kind&quot;:&quot;video&quot;,&quot;order&quot;:0}"/></metadata></asset-clip><asset-clip ref="a2" name="Music.wav" lane="-1" offset="75/25s" start="25/25s" duration="125/25s" srcEnable="audio" audioRole="dialogue"><metadata><md key="com.openframe.track" value="{&quot;name&quot;:&quot;Music&quot;,&quot;main&quot;:false,&quot;kind&quot;:&quot;audio&quot;,&quot;order&quot;:2}"/></metadata></asset-clip><metadata><md key="com.openframe.track" value="{&quot;name&quot;:&quot;Main&quot;,&quot;main&quot;:true,&quot;kind&quot;:&quot;video&quot;,&quot;order&quot;:1}"/></metadata></asset-clip><transition name="Cross Dissolve" offset="45/25s" duration="10/25s"><filter-video ref="dissolve"/><marker start="5/25s" duration="1/25s" value="Cut &amp; cue"/></transition><asset-clip ref="a1" name="Long shot.mp4" offset="55/25s" start="130/25s" duration="45/25s"><metadata><md key="com.openframe.track" value="{&quot;name&quot;:&quot;Main&quot;,&quot;main&quot;:true,&quot;kind&quot;:&quot;video&quot;,&quot;order&quot;:1}"/></metadata></asset-clip><gap name="Gap" offset="100/25s" start="0/25s" duration="25/25s"><metadata><md key="com.openframe.track" value="{&quot;name&quot;:&quot;Main&quot;,&quot;main&quot;:true,&quot;kind&quot;:&quot;video&quot;,&quot;order&quot;:1}"/></metadata></gap><asset-clip ref="a1" name="Long shot.mp4" offset="125/25s" start="200/25s" duration="50/25s"><ref-clip ref="c1" name="compound" lane="1" offset="225/25s" start="5/25s" duration="30/25s"><metadata><md key="com.openframe.track" value="{&quot;name&quot;:&quot;Overlay&quot;,&quot;main&quot;:false,&quot;kind&quot;:&quot;video&quot;,&quot;order&quot;:0}"/></metadata></ref-clip><metadata><md key="com.openframe.track" value="{&quot;name&quot;:&quot;Main&quot;,&quot;main&quot;:true,&quot;kind&quot;:&quot;video&quot;,&quot;order&quot;:1}"/></metadata></asset-clip><gap name="Gap" offset="175/25s" start="0/25s" duration="5/25s"><metadata><md key="com.openframe.track" value="{&quot;name&quot;:&quot;Main&quot;,&quot;main&quot;:true,&quot;kind&quot;:&quot;video&quot;,&quot;order&quot;:1}"/></metadata></gap></spine></sequence></project></event></library></fcpxml>
"
