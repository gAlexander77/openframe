{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Editor",
  "mainBinaryName": "video-editor",
  "version": "0.1.0",
  "identifier": "com.alex.video-editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Video Editor",
        "width": 1600,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 680,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#0b0c0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
