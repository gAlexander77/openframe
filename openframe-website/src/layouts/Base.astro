---
// Every page: the head (title, description, canonical, Open Graph and
// Twitter cards, icons, manifest, JSON-LD), the header and the footer.
import "@fontsource-variable/inter";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "../styles/global.css";
import "../styles/components.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, href } from "../lib/site";

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page (a BreadcrumbList, say). */
  jsonld?: object[];
  /** The page's own social image (a path under public/), if any. */
  image?: string;
  imageAlt?: string;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
}
const { title, description, jsonld = [], noindex = false, image = "og.png", imageAlt = "OpenFrame: the open video editor AI can drive. Its editor window, with a timeline of clips and a title on the picture." } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.origin).href;
const fullTitle = title === SITE.name ? `${SITE.name}: ${SITE.tagline}` : `${title} | ${SITE.name}`;
const imageUrl = new URL(href(image), SITE.origin).href;

// One description of the software, the same on every page. The operating
// system is the one it is developed and tested on (docs/Release
// preparation.md); there is no packaged release, so the download is the
// source.
const app = {
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication", "SoftwareSourceCode"],
  name: SITE.name,
  description: SITE.description,
  url: new URL(href(), SITE.origin).href,
  image: imageUrl,
  applicationCategory: "MultimediaApplication",
  applicationSubCategory: "Video editor",
  operatingSystem: "Windows",
  license: "https://spdx.org/licenses/GPL-3.0-only.html",
  codeRepository: SITE.repo,
  programmingLanguage: ["TypeScript", "Rust"],
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
const ld = [app, ...jsonld];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#05060a" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={href("icons/icon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={href("icons/apple-touch-icon.png")} />
    <link rel="manifest" href={href("manifest.webmanifest")} />
    <link rel="sitemap" href={href("sitemap-index.xml")} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
